<Window x:Class="DGScopeProfileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DGScopeProfileManager"
        xmlns:models="clr-namespace:DGScopeProfileManager.Models"
        mc:Ignorable="d"
        Title="DGScope Profile Manager" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings" Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Generate Profile" Click="GenerateProfile_Click"/>
                <MenuItem Header="_Refresh All" Click="RefreshAll_Click"/>
                <Separator/>
                <MenuItem Header="_DGScope Default Settings" Click="DefaultSettings_Click"/>
                <MenuItem Header="_Fix All Video Map Paths" Click="FixAllPaths_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Check for Updates" Click="CheckForUpdates_Click"/>
                <Separator/>
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid Margin="10">
            <!-- Main Split View -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" MaxWidth="300"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="2.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: CRC Profiles -->
                <GroupBox Grid.Column="0" Header="CRC ARTCC Profiles">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button Content="Generate Profile" Click="GenerateProfile_Click" Name="GenerateButton"/>
                        </StackPanel>

                        <ListBox Name="CrcProfilesList"
                                 SelectionMode="Single"
                                 SelectionChanged="CrcProfilesList_SelectionChanged"
                                 MouseDoubleClick="CrcProfilesList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ArtccCode}" FontSize="14" FontWeight="Bold"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

                <!-- Right Panel: DGScope Facilities & Profiles -->
                <GroupBox Grid.Column="2" Header="DGScope Profiles">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TreeView for hierarchical display -->
                        <TreeView Grid.Row="0" Name="FacilitiesTree"
                                  SelectedItemChanged="FacilityTree_SelectionChanged"
                                  MouseDoubleClick="FacilitiesTree_MouseDoubleClick">
                            <TreeView.ItemContainerStyle>
                                <!-- Expand all items by default -->
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <!-- Facility Level Template - simplified to just show ARTCC code -->
                                <HierarchicalDataTemplate DataType="{x:Type models:Facility}" ItemsSource="{Binding Profiles}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ArtccCode}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text=" (" Foreground="Gray" FontSize="11"/>
                                        <TextBlock Text="{Binding Profiles.Count}" Foreground="Gray" FontSize="11"/>
                                        <TextBlock Text=" profiles)" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>

                                <!-- Profile Level Template -->
                                <DataTemplate DataType="{x:Type models:DgScopeProfile}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <!-- Profile Actions -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Name="LaunchDGScopeButton" Content="Launch DGScope" Click="LaunchDGScope_Click" Background="#4CAF50" Foreground="White"/>
                            <Button Name="EditProfileButton" Content="Edit Profile" Click="EditProfile_Click"/>
                            <Button Name="DeleteProfileButton" Content="Delete Profile" Click="DeleteProfile_Click"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
