<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DGScopeProfileManager.Views.PrefSetSelectionWindow"
        Title="Select CRC PrefSet (Optional)"
        WindowStartupLocation="Manual"
        Width="500" Height="500"
        MinHeight="400"
        Background="#2D2D30"
        Foreground="#CCCCCC"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Text="Select a CRC PrefSet to apply display settings (optional):"
                       FontSize="14"
                       Foreground="#FFFFFF"
                       TextWrapping="Wrap"/>
            <TextBlock Text="PrefSets contain brightness, range, leader direction, and altitude filter settings."
                       FontSize="11"
                       Foreground="#999999"
                       Margin="0 5 0 0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ListBox Grid.Row="1"
                 Name="PrefSetsList"
                 Background="#3E3E42"
                 Foreground="#CCCCCC"
                 BorderBrush="#555555"
                 SelectionMode="Single"
                 Margin="0 0 0 15"
                 MouseDoubleClick="PrefSetsList_MouseDoubleClick"
                 SelectionChanged="PrefSetsList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="5">
                        <TextBlock Text="{Binding Name}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#FFFFFF"/>
                        <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                            <TextBlock Text="Range: "
                                       FontSize="11"
                                       Foreground="#999999"/>
                            <TextBlock Text="{Binding Range, StringFormat={}{0:F0} NM}"
                                       FontSize="11"
                                       Foreground="#AAAAAA"/>
                            <TextBlock Text=" | Maps: "
                                       FontSize="11"
                                       Foreground="#999999"
                                       Margin="10 0 0 0"/>
                            <TextBlock Text="{Binding SelectedVideoMapIds.Count}"
                                       FontSize="11"
                                       Foreground="#AAAAAA"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0 0 0 15">
            <TextBlock Text="Profile Name:"
                       FontSize="12"
                       Foreground="#FFFFFF"
                       Margin="0 0 0 5"/>
            <TextBox Name="ProfileNameTextBox"
                     Background="#3E3E42"
                     Foreground="#FFFFFF"
                     BorderBrush="#555555"
                     Padding="8 6"
                     FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Name="SkipButton"
                    Content="Skip PrefSet"
                    Width="100"
                    Height="32"
                    Margin="0 0 10 0"
                    Click="SkipButton_Click"
                    Background="#555555"
                    Foreground="#FFFFFF"
                    FontWeight="Bold"
                    ToolTip="Continue without applying PrefSet settings"/>
            <Button Name="OkButton"
                    Content="Apply"
                    Width="100"
                    Height="32"
                    Margin="0 0 10 0"
                    Click="OkButton_Click"
                    Background="#007ACC"
                    Foreground="#FFFFFF"
                    FontWeight="Bold"/>
            <Button Name="CancelButton"
                    Content="Cancel"
                    Width="100"
                    Height="32"
                    Click="CancelButton_Click"
                    Background="#555555"
                    Foreground="#FFFFFF"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
